# MongoDB Atlas Connection URI
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://user:password@cluster0.example.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=netflix_analytics

# Flask Secret Key
SECRET_KEY=super-secret-key-change-in-production

# Server Port
PORT=5000
